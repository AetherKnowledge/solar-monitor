{
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm --dir web dev",
    "monitor": "pio device monitor -b 115200",
    "build:web": "pnpm --filter web build && pio run -t buildweb",
    "build:firmware": "pio run",
    "build": "pnpm build:web && pnpm build:firmware",
    "upload": "pio run -t upload",
    "upload:web": "pnpm build:web && pio run -t uploadweb",
    "upload:storage": "pio run -t uploadstorage",
    "clang": "pio run -t compiledb",
    "upload:ota:firmware": "pnpm build:firmware && tsx scripts/ota.ts firmware",
    "upload:ota:web": "pnpm build:web && tsx scripts/ota.ts web",
    "upload:ota:config": "tsx scripts/ota.ts config",
    "ota:restart": "tsx scripts/ota.ts restart",
    "flash": "pnpm upload && pnpm build:web  && pnpm upload:web && pnpm monitor",
    "manifest": "tsx scripts/generate-manifest.ts",
    "release": "pnpm build && tsx scripts/generate-manifest.ts",
    "generate-keys": "tsx scripts/generate-keys.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.1"
  }
}
